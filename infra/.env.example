# ── Core ─────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── PostgreSQL (+ TimescaleDB) ───────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smartwash
POSTGRES_USER=smartwash
POSTGRES_PASSWORD=change_me            # secret → vault in prod
DATABASE_URL=postgresql://smartwash:change_me@postgres:5432/smartwash

# ── Redis (locks / cache / WS fanout) ────────────────
REDIS_URL=redis://redis:6379

# ── NATS JetStream (event bus / outbox relay) ────────
NATS_URL=nats://nats:4222

# ── Temporal (saga) ──────────────────────────────────
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default               # auto-setup provisions "default"
OWNER_ACCOUNT=OWNER-ACC-0001             # bank account the Owner QR pays into
STAFF_REVIEW_TIMEOUT_MS=86400000         # manual-review window (24h) → reject on timeout

# ── Outbox relay (per producer; empty = publish all aggregate types) ──
OUTBOX_AGGREGATE_TYPES=                  # e.g. "ledger" in ledger, "payment" in payment

# ── EMQX (MQTT) ──────────────────────────────────────
MQTT_URL=mqtt://emqx:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=change_me
HEARTBEAT_TIMEOUT_SEC=30                  # no status for N s → Machine FSM OFFLINE
# Device simulator: JSON of machines to emulate (must match DB machine rows)
SIM_DEVICES=[]

# ── MinIO (object storage — slip images) ─────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_SLIPS=slips

# ── Keycloak (auth / RBAC) ───────────────────────────
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=smartwash
KEYCLOAK_CLIENT_ID=smartwash-api
KEYCLOAK_CLIENT_SECRET=change_me
KEYCLOAK_AUDIENCE=                       # optional: enforce token `aud`

# ── Internal service-to-service auth ─────────────────
# Shared secret for internal endpoints (/auth/introspect, /rbac/check, ...).
# Gateway/BFF sends it as the X-Internal-Token header. Fail-closed if unset.
INTERNAL_SERVICE_TOKEN=change_me_internal

# ── External ─────────────────────────────────────────
GOOGLE_MAPS_API_KEY=                     # empty → delivery falls back to haversine
# Delivery fee (kip): fee = max(min, base + perKm * km)
DELIVERY_BASE_FEE=10000
DELIVERY_PER_KM=3000
DELIVERY_MIN_FEE=10000
FCM_SERVER_KEY=change_me
SMS_GATEWAY_URL=change_me
SMTP_URL=smtp://user:pass@smtp:587

# ── Observability ────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
PROMETHEUS_SCRAPE=true
