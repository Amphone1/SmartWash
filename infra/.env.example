# ── Core ─────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── PostgreSQL (+ TimescaleDB) ───────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smartwash
POSTGRES_USER=smartwash
POSTGRES_PASSWORD=change_me            # secret → vault in prod
DATABASE_URL=postgresql://smartwash:change_me@postgres:5432/smartwash

# ── Redis (locks / cache / WS fanout) ────────────────
REDIS_URL=redis://redis:6379

# ── NATS JetStream (event bus / outbox relay) ────────
NATS_URL=nats://nats:4222

# ── Temporal (saga) ──────────────────────────────────
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=smartwash

# ── EMQX (MQTT) ──────────────────────────────────────
MQTT_URL=mqtt://emqx:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=change_me

# ── MinIO (object storage — slip images) ─────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_SLIPS=slips

# ── Keycloak (auth / RBAC) ───────────────────────────
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=smartwash
KEYCLOAK_CLIENT_ID=smartwash-api
KEYCLOAK_CLIENT_SECRET=change_me

# ── External ─────────────────────────────────────────
GOOGLE_MAPS_API_KEY=change_me
FCM_SERVER_KEY=change_me
SMS_GATEWAY_URL=change_me
SMTP_URL=smtp://user:pass@smtp:587

# ── Observability ────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
PROMETHEUS_SCRAPE=true
