{
  "name": "db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/db/src",
  "projectType": "library",
  "targets": {
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node --project libs/db/tsconfig.json libs/db/src/migrate.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/db/src --max-warnings 0"
      }
    }
  }
}
