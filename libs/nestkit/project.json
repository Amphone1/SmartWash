{
  "name": "nestkit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/nestkit/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p libs/nestkit/tsconfig.lib.json" },
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint libs/nestkit/src --max-warnings 0" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "jest --config libs/nestkit/jest.config.ts" }
    }
  }
}
