# ── Dependencies ─────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Nx ───────────────────────────────────────────────
.nx/cache
.nx/workspace-data
dist/
tmp/
out-tsc/

# ── Test / coverage ──────────────────────────────────
coverage/
*.lcov
.jest-cache/

# ── Env / secrets ────────────────────────────────────
.env
.env.local
.env.*.local
!infra/.env.example

# ── Editor / OS ──────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────
*.log
npm-debug.log*

# ── Build artifacts ──────────────────────────────────
*.tsbuildinfo
# Guard against accidental in-place tsc emit inside source trees
libs/**/src/**/*.js
libs/**/src/**/*.d.ts
libs/**/src/**/*.map
services/**/src/**/*.js
services/**/src/**/*.d.ts
services/**/src/**/*.map
